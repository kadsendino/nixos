include ~/.cache/ags/user/generated/kitty-colors.conf
# Shell
shell            fish

# Behaviour
window_padding_width 5
cursor_shape block
hide_window_decorations yes
confirm_os_window_close 0
# allow_remote_control yes
shell_integration disabled

# Window settings
# Initial window size in cells (approximate equivalent of dimensions)
initial_window_width  80c
initial_window_height 22c
# Window padding (Kitty uses pixels)
window_padding_width 10
window_padding_height 10

# Disable window decorations (similar to decorations = "None")
window_decorations none

# Opacity (1.0 = fully opaque)
background_opacity 1.0

# Font settings
font_family SauceCodePro Nerd Font Mono
bold_font auto
italic_font auto
bold_italic_font auto
font_size 18.0

# BEGIN_KITTY_THEME
# Blueberry Mango
include current-theme.conf
# END_KITTY_THEME
