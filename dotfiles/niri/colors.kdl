layout {

    focus-ring {
        active-color   "#abc7ff"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#abc7ff"
        inactive-color "#44474e"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#abc7ff"
        inactive-color "#bec6dc"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#abc7ff80"
    }
}

